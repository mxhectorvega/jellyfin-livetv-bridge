# ---------------------------------------------------------------------------
# jellyfin-livetv-bridge — variables de entorno
# Copia este archivo a .env y ajusta. NUNCA lo subas al repositorio.
# Las rutas por defecto son ABSOLUTAS (/config y /data) y coinciden con los
# volumenes del docker-compose.yml.
# ---------------------------------------------------------------------------

# --- Rutas (absolutas) ---
LVB_CONFIG_DIR=/config
LVB_DATA_DIR=/data

# --- HTTP ---
LVB_HOST=0.0.0.0
LVB_PORT=8581
# Base publica que se escribe en las URLs del M3U que ve Jellyfin.
# Debe ser una direccion que el cliente de Jellyfin pueda alcanzar
# (la LAN del host, NO localhost si Jellyfin corre en otra maquina).
LVB_PUBLIC_BASE=http://10.0.0.21:8581
# IP concreta donde se ESCUCHA. Manda sobre LVB_HOST; vacio = 0.0.0.0 (todas).
# Con esto el puerto deja de quedar expuesto en todas las interfaces.
LVB_BIND_IP=10.0.0.21
# Token OPCIONAL para los endpoints que CAMBIAN estado (POST /catalog, POST
# /reload). Vacio = sin autenticacion. Los GET (/playlist.m3u, /epg.xml) siguen
# abiertos porque Jellyfin los consume sin cabeceras.
LVB_API_TOKEN=

# --- Ingesta y validacion ---
LVB_PROBE_TIMEOUT_S=10
# Modo de validacion: ffprobe (rapido, puede dar falsos positivos en HLS de
# plantilla) o liveness (baja bytes de verdad). Se recomienda liveness.
LVB_PROBE_MODE=liveness
# 2, NO 8: medido contra el CDN de Pluto, la concurrencia alta hace que devuelva
# manifiestos VACIOS (1/12 accesibles con 6 hilos contra 22/24 con 2). Un
# barrido con hilos de mas no es un barrido mas rapido, es uno que miente.
LVB_PROBE_WORKERS=2
# Incluir en la salida los canales cifrados / DRM / con auth (marcados).
LVB_INCLUDE_PROTECTED=true

# --- Salida ---
LVB_PLAYLIST_NAME=playlist.m3u
LVB_EPG_NAME=epg.xml
# Catalogo visible: los tres se alimentan y validan, pero Jellyfin ve SOLO el
# que este aqui (nacionales|pluto|vix). Vacio o "todos" = todos juntos.
# Se puede cambiar en caliente con: curl -X POST .../catalog/pluto
LVB_ACTIVE_CATALOG=nacionales

# --- Fuente de TV Azteca (integrada) ---
# El bridge resuelve el token de mediastream por si mismo: las URLs del
# catalogo que apunten al proveedor local (127.0.0.1:8582) se reescriben al
# master autenticado, tanto al validar como al servir /stream.
LVB_AZTECA_ENABLED=true
LVB_AZTECA_BASE=http://127.0.0.1:8582

# --- Transcodificacion ---
# auto | vaapi | qsv | cpu | off   (off = siempre -c copy)
LVB_HWACCEL=auto
# Umbral de canales simultaneos a transcodificar (limite de CPU sin GPU)
LVB_MAX_TRANSCODES=2

# --- Rele HLS con colchon propio ---
# Con el rele activo, el M3U publicado apunta a /relay/<id> en vez de /stream/<id>.
# Repara huecos, re-resuelve el master (variantes que rotan) y salta a la fuente
# alterna. Sin el, /stream sigue disponible igual.
LVB_RELAY_ENABLED=true
# User-Agent para las peticiones del rele. Vacio (recomendado): mdstrm responde
# 403 a los UA de navegador en los segmentos de TV Azteca, y sin UA funciona.
# Cuando entre un CDN que lo exija habra que hacerlo POR CANAL, no global.
LVB_RELAY_USER_AGENT=
# Cosido de la linea de tiempo al CAMBIAR DE FUENTE (src/ts_splice.py): desplaza
# PCR/PTS/DTS de la fuente nueva para que continue a la vieja, y marca
# discontinuity_indicator una vez por PID. Sin cambio de fuente no escribe un
# byte (es una pasada de lectura), pero se puede apagar del todo.
LVB_RELAY_REMENDAR=true
# Duracion de un cuadro en ticks de 90 kHz: 3003 a 29.97 fps, 3600 a 25. Es el
# hueco que se deja entre el ultimo sello de la fuente vieja y el primero de la
# nueva. Un cuadro de mas o de menos no se ve; un salto de segundos si.
LVB_RELAY_PASO_CUADRO=3003
# Precalentar deja el primer byte en ~0.02 s (el sondeo de Jellyfin espera 3 s y
# un rele en frio tarda ~3.5 s), pero sostiene ~330 KB/s de bajada continua POR
# CANAL: 10 canales son ~26 Mbps. El tope evita que un catalogo de 198 canales
# (Pluto) abra 198 lectores; el resto arranca cuando alguien lo pide.
LVB_RELAY_PRECALENTAR=true
LVB_RELAY_PRECALENTAR_MAX=16
# Segundos sin clientes tras los cuales se apaga un rele que YA se habia usado.
# Los precalentados (nunca usados) no se apagan por esto.
LVB_RELAY_IDLE_S=900

# --- Resiliencia ---
LVB_HEALTH_INTERVAL_S=300
LVB_HEALTH_FAILS_TO_DISABLE=3
LVB_HEALTH_OKS_TO_ENABLE=2
LVB_HEALTH_BACKOFF_BASE_S=5
LVB_HEALTH_BACKOFF_MAX_S=120

# --- Logs ---
LVB_LOG_LEVEL=INFO
# json | text
LVB_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# jellyfin-livetv-bridge — variables de entorno
# Copia este archivo a .env y ajusta. NUNCA lo subas al repositorio.
# Las rutas por defecto son ABSOLUTAS (/config y /data) y coinciden con los
# volumenes del docker-compose.yml.
# ---------------------------------------------------------------------------

# --- Rutas (absolutas) ---
LVB_CONFIG_DIR=/config
LVB_DATA_DIR=/data

# --- HTTP ---
LVB_HOST=0.0.0.0
LVB_PORT=8581
# Base publica que se escribe en las URLs del M3U que ve Jellyfin.
# Debe ser una direccion que el cliente de Jellyfin pueda alcanzar
# (la LAN del host, NO localhost si Jellyfin corre en otra maquina).
LVB_PUBLIC_BASE=http://10.0.0.21:8581
# IP de la LAN del host donde se publica el puerto (no 0.0.0.0)
LVB_BIND_IP=10.0.0.21

# --- Ingesta y validacion ---
LVB_PROBE_TIMEOUT_S=10
# Modo de validacion: ffprobe (rapido, puede dar falsos positivos en HLS de
# plantilla) o liveness (baja bytes de verdad). Se recomienda liveness.
LVB_PROBE_MODE=liveness
LVB_PROBE_WORKERS=8
# Incluir en la salida los canales cifrados / DRM / con auth (marcados).
LVB_INCLUDE_PROTECTED=true

# --- Salida ---
LVB_PLAYLIST_NAME=playlist.m3u
LVB_EPG_NAME=epg.xml
# Catalogo visible: los tres se alimentan y validan, pero Jellyfin ve SOLO el
# que este aqui (nacionales|pluto|vix). Vacio o "todos" = todos juntos.
# Se puede cambiar en caliente con: curl -X POST .../catalog/pluto
LVB_ACTIVE_CATALOG=nacionales

# --- Fuente de TV Azteca (integrada) ---
# El bridge resuelve el token de mediastream por si mismo: las URLs del
# catalogo que apunten al proveedor local (127.0.0.1:8582) se reescriben al
# master autenticado, tanto al validar como al servir /stream.
LVB_AZTECA_ENABLED=true
LVB_AZTECA_BASE=http://127.0.0.1:8582

# --- Transcodificacion ---
# auto | vaapi | qsv | cpu | off   (off = siempre -c copy)
LVB_HWACCEL=auto
# Umbral de canales simultaneos a transcodificar (limite de CPU sin GPU)
LVB_MAX_TRANSCODES=2

# --- Resiliencia ---
LVB_HEALTH_INTERVAL_S=300
LVB_HEALTH_FAILS_TO_DISABLE=3
LVB_HEALTH_OKS_TO_ENABLE=2
LVB_HEALTH_BACKOFF_BASE_S=5
LVB_HEALTH_BACKOFF_MAX_S=120

# --- Logs ---
LVB_LOG_LEVEL=INFO
# json | text
LVB_LOG_FORMAT=json
